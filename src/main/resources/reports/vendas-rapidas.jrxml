	<parameter name="emitente_id" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT ciaf_id.emitente.emit_xnome,
    ciaf_id.emitente.image,
	ciaf_id.vendas.client,
	ciaf_id.vendas.data,
	ciaf_id.vendas.valor,
	ciaf_id.vendas.vendedor,
	ciaf_id.vendas.id,
	ciaf_id.emitente.id,
	ciaf_id.vendas.emitente_id
FROM ciaf_id.emitente,
	ciaf_id.vendas
WHERE 
	 ciaf_id.emitente.id = $P{emitente_id}]]></query>
