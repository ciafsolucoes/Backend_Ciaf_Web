	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Ciaf Data Adapter"/>
	<parameter name="my_sale_id" class="java.lang.Long">
		<description><![CDATA[Id for search by id sale]]></description>
	</parameter>
	<query language="SQL"><![CDATA[SELECT emitente_1.emitente.emit_xnome,
        emitente_1.emitente.image,   
       emitente_1.vendasitems.id,
       emitente_1.vendasitems.product_id,
       emitente_1.vendasitems.prod_qcom,
       emitente_1.vendasitems.prod_vun_com,
       emitente_1.vendasitems.total_price,
       emitente_1.vendasitems.venda_id,
       emitente_1.vendas.data,
       emitente_1.vendas.client,
       emitente_1.vendas.valor,
       emitente_1.vendas.vendedor,
       emitente_1.vendas.id,
       emitente_1.products.id,
       emitente_1.products.description,
       emitente_1.products.salevalue,
       emitente_1.persons.address,
       emitente_1.vendas.client_email,
       emitente_1.vendas.client_cell,
       emitente_1.persons.city,
       emitente_1.persons.number,
       emitente_1.persons.state,
       emitente_1.persons.cep,
       emitente_1.persons.cpf_cnpj,
       emitente_1.vendas.id_client
FROM  emitente_1.vendasitems     
         INNER JOIN emitente_1.vendas ON
    emitente_1.vendasitems.venda_id = emitente_1.vendas.id
         INNER JOIN emitente_1.products ON
    emitente_1.products.id = emitente_1.vendasitems.product_id
         LEFT JOIN emitente_1.persons ON
    emitente_1.vendas.id_client= emitente_1.persons.id
    JOIN   emitente_1.emitente ON emitente_1.vendas.emitente_id = emitente_1.emitente.id
WHERE
    emitente_1.vendas.id = $P{my_sale_id}]]></query>
