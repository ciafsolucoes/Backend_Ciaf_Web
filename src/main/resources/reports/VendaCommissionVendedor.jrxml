	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="41"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="241"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="749"/>
