	<style name="aternate_colors_style" mode="Opaque" backcolor="#FFFFFF">
		<conditionalStyle mode="Opaque" backcolor="#E6E6E6">
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
		</conditionalStyle>
	</style>
	<parameter name="emitente_id" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT persons.corporate,
       coalesce( persons.email," ") AS email,
       coalesce( persons.city," ") AS city,
       coalesce( persons.cellnumber," ") AS cellnumber,
       coalesce( persons.state," ") AS state,
       persons.cep,
       coalesce(persons.nickname," ") AS nickname,
       emitente.emit_xnome,
       emitente.image
FROM ciaf_id.persons AS persons
JOIN ciaf_id.emitente AS emitente
ON ciaf_id.persons.emitente_id = ciaf_id.emitente.id
WHERE emitente.id = $P{emitente_id}
AND persons.emitente_id = $P{emitente_id}

]]></query>
