	<parameter name="seller" class="java.lang.String"/>
	<parameter name="baseDate" class="java.util.Date"/>
	<parameter name="baseDate2" class="java.util.Date"/>
	<parameter name="emitente_id" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT
    e.emit_xnome,
    e.image,
    v.client,
    v.data,
    v.valor,
    v.vendedor,
    v.id,
    vd.commission,
    vd.name
FROM ciaf_id.vendas v
JOIN ciaf_id.emitente e
    ON e.id = v.emitente_id
LEFT JOIN ciaf_id.vendedores vd
    ON vd.emitente_id = v.emitente_id
   AND vd.name = v.vendedor
WHERE v.emitente_id = $P{emitente_id}
  AND v.vendedor = $P{seller}
  AND STR_TO_DATE(v.data, '%d/%m/%Y') >= $P{baseDate}
  AND STR_TO_DATE(v.data, '%d/%m/%Y') <= $P{baseDate2}
ORDER BY v.id]]></query>
