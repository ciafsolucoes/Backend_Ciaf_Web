	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Ciaf Data Adapter"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="933"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="53"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="147"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="843"/>
	<parameter name="os_id" class="java.lang.Long"/>
	<query language="SQL"><![CDATA[SELECT 
   ciaf_id.ord_serv. id,
	ciaf_id.ord_serv.aliquota,
	ciaf_id.ord_serv.c_trib_nac,
	ciaf_id.ord_serv.client_id,
	ciaf_id.ord_serv.codigo,
	ciaf_id.ord_serv.descricao,
	ciaf_id.ord_serv.iss_retido,
	ciaf_id.ord_serv.obs,
	ciaf_id.ord_serv.unidade,
	ciaf_id.ord_serv.valor_pecas,
	ciaf_id.ord_serv.valor_servico,
	ciaf_id.ord_serv.valor_total,
	ciaf_id.ord_serv.client_cell,
	ciaf_id.ord_serv.client_email,
	ciaf_id.ord_serv.cliente,
	DATE_FORMAT(ciaf_id.ord_serv.data_emissao,'%d/%m/%Y') AS data_emissao_fmt,
	ciaf_id.ord_serv.condicoes,
	ciaf_id.ord_serv.equipamento,
	ciaf_id.ord_serv.marca,
	DATE_FORMAT(ciaf_id.ord_serv.previsao_entrega,'%d/%m/%Y') AS previsao_entrega_fmt,
	ciaf_id.ord_serv.status,
	ciaf_id.ord_serv.tecnico,
	ciaf_id.ord_serv.vendedor,
	ciaf_id.ord_serv.vendedor_cell
FROM ciaf_id.ord_serv
 JOIN   ciaf_id.emitente ON ciaf_id.ord_serv.emitente_id = ciaf_id.emitente.id
WHERE 
	 ciaf_id.ord_serv.id = $P{os_id}]]></query>
