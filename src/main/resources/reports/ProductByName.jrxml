	<parameter name="emitente_id" class="java.lang.String"/>
	<parameter name="start_name" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT ciaf_id.emitente.emit_xnome,
        ciaf_id.emitente.image,
       ciaf_id.products.description,
       ciaf_id.products.stock,
       ciaf_id.products.stock_minimum,
       ciaf_id.products.prod_vun_com,
       ciaf_id.products.unit,
       ciaf_id.products.id,
       ciaf_id.products.salevalue,
       ciaf_id.products.purchasevalue
FROM ciaf_id.products JOIN ciaf_id.emitente ON ciaf_id.emitente.id = ciaf_id.products.emitente_id 
   WHERE ciaf_id.products.description LIKE CONCAT('%',  $P{start_name}, '%')  AND  ciaf_id.products.emitente_id  = $P{emitente_id}
 ]]></query>
