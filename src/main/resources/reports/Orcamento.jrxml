<jasperReport name="BudgetLoca" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="ca12d58b-7dda-4187-85a7-7da91107f08f" floatColumnFooter="true">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="CIAF"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="843"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="143"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="143"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="846"/>
	<parameter name="my_budget_id" class="java.lang.Long">
		<description><![CDATA[id do budget para query]]></description>
	</parameter>
	<parameter name="emitente_id" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT ciaf_id.budgetsitems.prod_vun_com,
       ciaf_id.budgetsitems.total_price,
       ciaf_id.budgetsitems.prod_qcom,
       ciaf_id.budgets.data,
       ciaf_id.budgets.client,
       ciaf_id.budgets.valor,
       ciaf_id.budgets.validade,
       ciaf_id.budgets.status,
       ciaf_id.budgets.aprovado_por,
       ciaf_id.products.description,
       ciaf_id.products.salevalue,
       ciaf_id.budgetsitems.budget_id,
       ciaf_id.budgets.prazo,
       ciaf_id.budgets.id,
       ciaf_id.budgets.vendedor,
       coalesce(ciaf_id.budgets.client_cell, ' - ') AS client_cell,
       ciaf_id.budgetsitems.product_id,
       ciaf_id.budgets.observacao,
       ciaf_id.budgets.desconto,
       ciaf_id.budgets.nr_budget,
       (
         SELECT MAX(bp.forma)
         FROM ciaf_id.budgets_pg bp
         WHERE bp.budgets_id = ciaf_id.budgets.id
       ) AS forma,
       ciaf_id.emitente.emit_xbairro,
       ciaf_id.emitente.emit_xlgr,
       ciaf_id.emitente.emit_xcpl,
       ciaf_id.emitente.emit_xmun,
       ciaf_id.emitente.emit_xnome,
       ciaf_id.emitente.emit_nro,
       ciaf_id.emitente.phonenumber,
       ciaf_id.emitente.cellnumber,
       ciaf_id.emitente.image,
       ciaf_id.budgets.client_id,
       ciaf_id.persons.address,
       ciaf_id.persons.number,
       ciaf_id.persons.district,
       ciaf_id.persons.city,
       ciaf_id.persons.state,
       ciaf_id.persons.cpf_cnpj,
       ciaf_id.persons.cep,
       coalesce(ciaf_id.persons.cellnumber, ' - ') AS cellnumber
FROM ciaf_id.budgetsitems
INNER JOIN ciaf_id.budgets
    ON ciaf_id.budgetsitems.budget_id = ciaf_id.budgets.id
INNER JOIN ciaf_id.products
    ON ciaf_id.products.id = ciaf_id.budgetsitems.product_id
JOIN ciaf_id.emitente
    ON ciaf_id.budgets.emitente_id = ciaf_id.emitente.id
JOIN ciaf_id.persons
    ON ciaf_id.persons.id = ciaf_id.budgets.client_id
WHERE ciaf_id.budgets.id = $P{my_budget_id}
  AND ciaf_id.budgets.emitente_id = $P{emitente_id}]]></query>
