	<parameter name="basic_parameter" class="java.lang.String"/>
	<parameter name="emitente_id" class="java.lang.String"/>
	<query language="SQL"><![CDATA[
	SELECT ciaf_id.persons.corporate,
	ciaf_id.persons.email,
	ciaf_id.persons.city,
	ciaf_id.persons.cellnumber,
	ciaf_id.persons.state,
	ciaf_id.persons.cep,
	ciaf_id.persons.nickname,
	ciaf_id.emitente.emit_xnome,
	ciaf_id.emitente.image
FROM ciaf_id.persons
	JOIN   ciaf_id.emitente ON ciaf_id.persons.emitente_id = ciaf_id.emitente.id
	WHERE SUBSTRING(birthday_date, 4,2) =  $P{basic_parameter}
	AND ciaf_id.emitente.id = $P{emitente_id}
	AND ciaf_id.persons.emitente_id = $P{emitente_id}
    ]]></query>
