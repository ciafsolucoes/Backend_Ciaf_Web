	<parameter name="emitente_id" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT ciaf_id.emitente.emit_xnome,
    ciaf_id.emitente.image,
	ciaf_id.apagar.addition,
	ciaf_id.apagar.creditor,
	ciaf_id.apagar.dateofoperation,
	ciaf_id.apagar.description,
	ciaf_id.apagar.discount,
	ciaf_id.apagar.duedate,
	ciaf_id.apagar.final_value,
	ciaf_id.apagar.final_value_real,
	ciaf_id.emitente.id
FROM ciaf_id.apagar
JOIN ciaf_id.emitente AS emitente
ON ciaf_id.apagar.emitente_id = emitente.id]]></query>
