	<parameter name="emitente_id" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT ciaf_id.persons.corporate,
       ciaf_id.persons.email,
       ciaf_id.persons.city,
       ciaf_id.persons.cellnumber,
       ciaf_id.persons.state,
       ciaf_id.persons.cep,
       ciaf_id.persons.nickname,
       ciaf_id.emitente.emit_xnome,
       ciaf_id.emitente.image,
       ciaf_id.persons.address,
       ciaf_id.persons.c_mun,
       ciaf_id.persons.district,
       ciaf_id.persons.number,
       ciaf_id.persons.observation,
       ciaf_id.persons.birthday_date,
       ciaf_id.persons.tipo,
       ciaf_id.persons.cpf_cnpj,
       ciaf_id.persons.compl
FROM ciaf_id.persons,
     ciaf_id.emitente
WHERE ciaf_id.emitente.id = $P{emitente_id}
  AND ciaf_id.persons.emitente_id = $P{emitente_id}
  ]]></query>
